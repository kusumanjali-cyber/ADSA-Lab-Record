#define MAX 10
int adj[MAX][MAX];
int visited[MAX];
int stack[MAX];
int top=-1;
int n;
void push(int v){
	stack[++top]=v;
}
int pop(){
	return stack[top--];
}
int isEmpty(){
	return(top==-1);
}
void dfs_stack(int start){
	push(start);
	visited[start]=1;
	while(!isEmpty()){
		int current=pop();
		printf("%d ",current);
		for(int i=n;i&gt;0;i--){
			if(adj[current][i]==1 &amp;&amp; !visited[i]){
				push(i);
				visited[i]=1;
			}
		}
	}
