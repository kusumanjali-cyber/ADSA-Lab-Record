er all insertions.</li><li data-ref="c313194a-12fa-47f8-9911-98fc47705fec">The second line displays the space-separated heap contents after performing <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="b4fb7421-d45c-4a3e-bd57-1b803fe85684" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="443d25d9-1fc2-4d88-a251-11c98905249e"><mjx-mi class="mjx-i" data-ref="85805603-2a17-4bc4-b9a4-46b7103235eb"><mjx-c class="mjx-c1D458 TEX-I" data-ref="b7374e52-b7de-468e-8ab4-f2dce7ea4d51"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="f7f7b64a-8d7b-4e9e-8887-0b24b1062e57"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="bbc73c45-edf0-49e5-9925-5dba40010d5e"><mi data-ref="502497bf-3de4-4dac-a2a5-73fcfa89bcb2">k</mi></math></mjx-assistive-mml></mjx-container> deletions of the root element.</li></ul><p data-ref="c2d32b2d-c070-4cd1-bd5c-03a34dea39be" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="ce52b601-f66b-45e2-a9ef-7b54797cf78e"></p><p data-ref="d78e0cc2-bfbc-46e7-a971-c302cdd3d182" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="b51728f4-b4f5-45df-99f8-e228a15b495e">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="f14d3ef3-4d5d-4019-9e61-c243f71f867b"><div class="ml-1 mb-3" data-ref="b6cd9d43-0aec-4af7-a7e2-a410eb177738"><b style="border-bottom:1px solid black;" data-ref="7861ff0f-be7e-4984-b423-d3b11be1a96c" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="8840d670-bbc8-44bc-9ff6-662130229c49" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="39c7d3c7-df1d-46b2-9841-29464a3a1812" data-undisplayed="undisplayed">minheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="a35fdcf9-acbb-48a3-b825-44d4a992c7be" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#define MAX_SIZE 20
int heap[MAX_SIZE];
int size = 0;
// Swap utility
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}
// Iterative heapify up
void heapifyUp(int index) {
    while (index &gt; 0) {
        int parent = (index - 1) / 2;
        if (heap[index] &lt; heap[parent]) {
            swap(&amp;heap[index], &amp;heap[parent]);
            index = parent;
        } else {
            break;
        }
    }
}
// Insert into min heap
void insert(int value) {
    heap[size] = value;
    heapifyUp(size);
    size++;
}
// Iterative heapify down
void heapifyDown(int index) {
    while (1) {
        int left = 2 * index + 1;
        int right = 2 * index + 2;
        int smallest = index;
        if (left &lt; size &amp;&amp; heap[left] &lt; heap[smallest])
            smallest = left;
        if (right &lt; size &amp;&amp; heap[right] &lt; heap[smallest])
            smallest = right;
        if (smallest != index) {
            swap(&amp;heap[index], &amp;heap[smallest]);
            index = smallest;
        } else {
            break;
        }
    }
}
// Delete root (minimum element)
void deleteMin() {
    if (size == 0) return;
    heap[0] = heap[size - 1];
    size--;
    heapifyDown(0);
}
// Print heap
void printHeap() {
    for (int i = 0; i &lt; size; i++) {
        printf("%d ", heap[i]);
    }
}
int main() {
    int n, k, val;
    // Read number of elements
    scanf("%d", &amp;n);
    // Insert elements into heap
    for (int i = 0; i &lt; n; i++) {
        scanf("%d", &amp;val);
        insert(val);
    }
    // Print heap after insertions
    printHeap();
    // Read number of deletions
    scanf("%d\n", &amp;k);
    // Perform deletions
    for (int i = 0; i &lt; k; i++) {
        deleteMin();
    }
    // Print heap after deletions
	printHeap();
	printf("\n");
    return 0;
}</pre><br data-ref="33cfa233-e7fd-46ac-bbd1-09fe1caeee31"></div></div><div class="row" data-ref="d94949d0-5c04-40fe-8150-cb98141fd1e1"><div class="col-12" data-ref="15235b48-b381-4538-a349-fb4022428270"><h5 class="execResultsHeading text-center" data-ref="3827b4d3-cee4-436d-8d80-1e522c5bf664">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="7f779dfc-1c5f-478e-b889-d4ec11d7edc4" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="847884c6-6bc7-443b-84b1-b7f9dfbc5875"><div class="row execution-results-border" data-ref="332fa5d6-31f9-4127-9408-f07b40f40bf3"><div class="col-12 p-2 text-center font-weight-bold" data-ref="281718be-cdb9-405d-b422-19b15cf5d853">Test Case - 1</div></div><div class="row execution-results-border" data-ref="14781e0b-710c-4893-8160-9b78cbf8cc1e"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="4d5647aa-a7e8-4618-9244-43f3e5b765d5">User Output</div></div><div class="row execution-results-border" data-ref="e5d19f61-345a-4931-b13b-dc045df33492"><div class="col-6" data-ref="306a08f5-152b-4980-bde7-85302613f865"><span class="cmd" title="User Input" data-ref="9ab32f45-0e21-4d97-bdcf-0f5dc0a14bf1">5</span></div></div><div class="row execution-results-border" data-ref="8f3e77f3-68da-4074-aa62-85bdd5433958"><div class="col-6" data-ref="fc785177-8780-4edc-905f-c672a520269e"><span class="cmd" title="User Input" data-ref="dec54fdf-27ac-42c8-a21a-d0927e20432f">20 15 30 5 10</span></div></div><div class="row execution-results-border" data-ref="fa82ab69-3efd-4774-862c-5c65687237e7"><div class="col-6" data-ref="17950434-a7fb-44de-bfa8-e452fc261b29"><span class="cmd" title="User Input" data-ref="f7302898-5a83-4a1d-9944-5764d4e7ffe9">2</span></div></div><div class="row execution-results-border" data-ref="f67283e7-a297-4d67-9ad2-8f03ed202b88"><div class="col-12" data-ref="412b96c6-41b5-4ba6-93de-a5440ba1174c"><pre class="outputPre" data-ref="07