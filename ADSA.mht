 data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="8ef7e428-0c8d-4672-ae40-0e8b0b6d0186"></p></span></div><div class="mb-3" data-ref="9a94c01d-038b-41a7-b5f6-ba3d5f449720"><div class="ml-1 mb-3" data-ref="caf18397-f32e-4919-b2bf-a35f348a890a"><b style="border-bottom:1px solid black;" data-ref="6f81593d-2f93-49d0-9ac3-9396f9c840eb" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="c026461e-67f0-447b-bdad-d213fbf059f2" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="5c48f922-6cba-4c35-bf58-8230e78472e2" data-undisplayed="undisplayed">dynamicKs.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="b1c58348-3546-4feb-9f8e-4f08215dba49" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
int knapsack(int weights[],int profits[],int n,int m){
	int M[n+1][m+1];
	for(int i=0;i&lt;=n;i++){
		for(int j=0;j&lt;=m;j++){
			if(i==0 || j==0)
				M[i][j]=0;
			else if(weights[i-1]&lt;=j)
				M[i][j]=(profits[i-1]+M[i-1][j-weights[i-1]]&gt;M[i-1][j]) ? (profits[i-1]+M[i-1][j-weights[i-1]]) : M[i-1][j];
			else
				M[i][j]=M[i-1][j];
		}
	}
	return M[n][m];
}

int main(){
	int n;
	scanf("%d",&amp;n);
	int weights[n],profits[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;weights[i]);
	}
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;profits[i]);
	}
	int capacity;
	scanf("%d",&amp;capacity);
	int maxProfit=knapsack(weights,profits,n,capacity);
	printf("%d\n",maxProfit);
	return 0;
}</pre><br data-ref="0c62e28c-a98c-4921-93ba-e6018f84dee7"></div></div><div class="row" data-ref="38c5d4a7-0119-441b-a473-aa29fa0b7f44"><div class="col-12" data-ref="7c689800-5689-4f7a-92ae-6237257bffb8"><h5 class="execResultsHeading text-center" data-ref="8849da2c-b7fd-4458-b3c5-b628f8c0d019">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="3c7ce812-32fa-466b-8ff0-304993839dea" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="eb31578f-e36f-48a6-906b-c54b80f3a67a"><div class="row execution-results-border" data-ref="196aed08-0e13-4303-b89b-ca4a8d5febe5"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c7046ecc-1d55-488a-8c04-40f17644df75">Test Case - 1</div></div><div class="row execution-results-border" data-ref="d35258c9-10b5-4735-b554-b7990aad64ba"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="ae43e33b-1f8d-4f58-a8c9-7ef4416251b5">User Output</div></div><div class="row execution-results-border" data-ref="d5d92259-4821-4f69-a127-b052d9a4f0b8"><div class="col-6" data-ref="48d6b2ed-0759-4435-a762-7c34dd189562"><span class="cmd" title="User Input" data-ref="b28449a4-ed62-417d-9905-03960b46becc">5</span></div></div><div class="row execution-results-border" data-ref="76617ba9-7c16-4c83-a707-d4314c2745f0"><div class="col-6" data-ref="4701995e-7f30-49f2-8165-faa141a54bf6"><span class="cmd" title="User Input" data-ref="6e12ebfd-e9e9-4f0f-9a44-71d47f967652">5 10 15 20 25</span></div></div><div class="row execution-results-border" data-ref="d78bef07-4577-4c13-b626-6e868500dc73"><div class="col-6" data-ref="b70949ed-6f22-4294-b068-2eef4a88d59c"><span class="cmd" title="User Input" data-ref="64f160bd-a6fc-45b6-9d1d-44efac8d56f0">10 20 30 40 50</span></div></div><div class="row execution-results-border" data-ref="ecb86711-79ba-409e-9516-3e0a4c87de94"><div class="col-6" data-ref="55460b9d-35dd-40e5-b63d-55a992638b7d"><span class="cmd" title