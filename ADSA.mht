pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="b10b6a25-288f-4172-a750-fac1ffc28c89" data-undisplayed="undisplayed">JsGreedy.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="75947a1c-0868-40c3-b0e6-1a865860ed10" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
typedef struct{
int id;
int deadline;
int profit;
}Job;

int compare(const void *a,const void *b){
	Job *j1=(Job *)a;
	Job *j2=(Job *)b;
	return j2-&gt;profit-j1-&gt;profit;
}

int main(){
	int n;
	scanf("%d",&amp;n);
	Job jobs[n];
	int i;
	for(i=0;i&lt;n;i++){
		scanf("%d %d %d",&amp;jobs[i].id,&amp;jobs[i].deadline,&amp;jobs[i].profit);
	}
	qsort(jobs,n,sizeof(Job),compare);
	int maxDeadline=0;
	for(i=0;i&lt;n;i++){
		if(jobs[i].deadline&gt;maxDeadline){
			maxDeadline=jobs[i].deadline;
		}
	}
	int slot[maxDeadline+1];
	for(i=0;i&lt;=maxDeadline;i++){
		slot[i]=-1;
	}
	int countJobs=0,totalProfit=0;
	for(i=0;i&lt;n;i++){
		for(int j=jobs[i].deadline;j&gt;0;j--){
			if(slot[j]==-1){
				slot[j]=jobs[i].id;
				countJobs++;
				totalProfit+=jobs[i].profit;
				break;
			}
		}
	}
	printf("%d %d\n",countJobs,totalProfit);
	return 0;
}</pre><br data-ref="561540f9-4060-4506-999d-683208967632"></div></div><div class="row" data-ref="8b763ee6-dcef-4b19-ad09-3fabf5e3d459"><div class="col-12" data-ref="8262edd5-6190-44d0-96aa-00f84c08f99e"><h5 class="execResultsHeading text-center" data-ref="fd5fe37c-0d41-4385-bd8e-667648ddbad4">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="64e57ad4-fe23-4952-8242-ecc02b3c96ac" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="12444bb1-ae70-4c0b-96fe-140279d73ff5"><div class="row execution-results-border" data-ref="a3badd9c-b192-4e3e-9c33-132ec9235679"><div class="col-12 p-2 text-center font-weight-bold" data-ref="9f709f05-d184-4298-8422-3b3145e4bdf8">Test Case - 1</div></div><div class="row execution-results-border" data-ref="7f47c2d3-1ed0-471b-8496-c21769033b22"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="8875b5b2-1a3d-4b36-a8ee-8f51cc8e2ca3">User Output</div></div><div class="row execution-results-border" data-ref="e4e2b9b4-6c23-4777-a199-07e020429165"><div class="col-6" data-ref="614c482e-6673-4d30-aa1e-b032540a111a"><span class="cmd" title="User Input" data-ref="a05dab73-8c81-4f33-b964-b8411ef5e719">4</span></div></div><div class="row execution-results-border" data-ref="3ac70e7e-3437-4134-a69d-23f79f4f154a"><div class="col-6" data-ref="0d80d18d-1aa3-46c2-b527-435da9fb3aa1"><span class="cmd" title="User Input" data-ref="ab6d8d06-42e2-4d7e-9628-9cf350c1b4c5">1 4 20</span></div></div><div class="row execution-results-border" data-ref="eddb1a0f-09f3-4eba-b7f8-dbef64af9884"><div class="col-6" data-ref="e6054626-d256-4a73-8f00-3ab9327c7898"><span class="cmd" title="User Input" data-ref="0862f0a2-081c-412f-b4dd-ebb88b26b026">2 1 10</span></div></div><div class="row execution-results-border" data-ref="7b6e6967-34a0-4557-8917-11cedb27d657"><div class="col-6" data-ref="1fca747a-5af3-45ca-bf1c-f1da04e535b5"><span class="cmd" title="User Input" d