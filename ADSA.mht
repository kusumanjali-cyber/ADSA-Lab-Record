<div class="container-xl" data-ref="52656f39-f802-4cd2-bad0-59951ed5042b"><header class="text-right" data-ref="d2a488df-1906-4f83-a01c-003a9d5641ec"> </header> <div class="page" data-ref="72b2384a-3048-4f91-b51a-9c4e8abbc1c4"><div id="lab-print" data-ref="a37564ef-b7b5-41ac-88de-4b0bd5f8ef62" data-id="lab-print"><div class="ct-print-new-page-after-always" data-ref="5a354a5d-4893-495f-b741-5771bb780152" data-break-after="always"><div data-ref="80c7bf12-cd24-4f8e-879a-cdefd021902d"><table class="table table-condensed table-bordered table-hover" data-ref="ac036235-f2a1-4c32-909a-207db0940681"><thead data-ref="ac51c1e9-8c66-42c6-8a9a-c75d9d311f26"><tr data-ref="0bdfb2ff-ce7b-4e8b-bb9d-717b4e6738f2"><th class="text-left align-middle" style="width:20%" data-ref="6cb4525a-28df-4499-8ad6-5cae38da9e90" data-undisplayed="undisplayed">S.No: 1</th> <th class="text-left align-middle" style="width:55%; font-weight: normal;" data-ref="b021bdaa-6073-48f6-aca0-4eae956543a6" data-undisplayed="undisplayed">Exp. Name: <b class="expTitle" data-ref="5afa530b-a844-460d-8a1e-5fc51d4c9343"><i data-ref="7aa89f1f-0f86-42b3-bad7-7ccab5175dc5">Program to implement AVL tree and its operations</i></b></th> <th class="text-left align-middle" style="width:25%" data-ref="68750305-b742-426f-8444-1fc915c9190a" data-undisplayed="undisplayed">Date: 2026-08-29</th></tr></thead></table></div><div class="ml-1" style="page-break-inside: auto" data-ref="15cc707a-d51d-4728-aaad-bc64c66cef78" data-undisplayed="undisplayed"><b style="border-bottom:1px solid black;" data-ref="6219ad7f-a897-4836-b6a3-4a335b442d4d" data-undisplayed="undisplayed">Aim:</b><br data-ref="3de1843b-1a2e-449f-a62a-4395bb474093"> <span class="question-text ql-editor" data-ref="ba09dd59-159e-4386-a72c-f00d687154e1"><p data-ref="101f60d4-dbc8-4b9a-b760-97377e22c453" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">Write a program to create an AVL tree using a provided set of elements stored in a file. Implement operations for inserting and deleting elements from the AVL tree. After constructing the tree, output the contents of the tree in in-order traversal to a new file.</p><p data-ref="f9ce8884-1cc5-48da-a108-0045e700deb4" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="0f1d6fe4-c50b-4aca-a410-97d5ea398a8c"></p><p data-ref="0f7a1be4-12f3-4c87-b569-e1c0863a0008" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="e82cf66f-3367-4122-994e-61f5bf435f03">Note: </strong>Refer to visible test cases for better understanding.</p></span></div><div class="mb-3" data-ref="f6f950a5-5e5f-4a8c-b148-7c990d42c7e3"><div class="ml-1 mb-3" data-ref="7197a1d8-468e-42dd-9d16-827470ef43a1"><b style="border-bottom:1px solid black;" data-ref="6b03c528-51c6-4703-a8f4-90def131dc0c" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="dd884613-497e-4d65-90bc-44292e9df1d1" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="62848f4a-a1ba-4324-91ff-a0caed8a8df8" data-undisplayed="undisplayed">avl_tree.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="a473f831-69fb-4b38-9613-d4b1daafd986" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;string.h&gt;
#include &lt;stdbool.h&gt;
typedef struct Node {
int key;
struct Node* left;
struct Node* right;
int height;
} Node;
int height(Node* N) {
	if (N == NULL) return 0;
	return N-&gt;height;
}
int max(int a, int b) {
	return (a &gt; b) ? a : b;
}

Node* newNode(int key) {
	Node* node = (Node*)malloc(sizeof(Node));
	node-&gt;key = key;
	node-&gt;left = node-&gt;right = NULL;
	node-&gt;height = 1;
	return node;
}

Node* rightRotate(Node* y) {
	Node* x = y-&gt;left;
	Node* T2 = x-&gt;right;
	x-&gt;right = y;
	y-&gt;left = T2;
	y-&gt;height = max(height(y-&gt;left), height(y-&gt;right)) + 1;
	x-&gt;height = max(height(x-&gt;left), height(x-&gt;right)) + 1;
	return x;
}
Node* leftRotate(Node* x) {
	Node* y = x-&gt;right;
	Node* T2 = y-&gt;left;
	y-&gt;left = x;
	x-&gt;right = T2;
	x-&gt;height = max(height(x-&gt;left), height(x-&gt;right)) + 1;
	y-&gt;height = max(height(y-&gt;left), height(y-&gt;right)) + 1;
	return y;
}
int getBalance(Node* N) {
	if (N == NULL) return 0;
	return height(N-&gt;left) - height(N-&gt;right);
}

Node* insert(Node* node, int key) {
	if (node == NULL)
		return newNode(key);
	if (key &lt; node-&gt;key)
		node-&gt;left = insert(node-&gt;left, key);
	else if (key &gt; node-&gt;key)
		node-&gt;right = insert(node-&gt;right, key);
	else
	return node; 
	node-&gt;height = 1 + max(height(node-&gt;left), height(node-&gt;right));
	int balance = getBalance(node);
	if (balance &gt; 1 &amp;&amp; key &lt; node-&gt;left-&gt;key) return rightRotate(node);
	if (balance &lt; -1 &amp;&amp; key &gt; node-&gt;right-&gt;key) return leftRotate(node);
	if (balance &gt; 1 &amp;&amp; key &gt; node-&gt;left-&gt;key) {
		node-&gt;left = leftRotate(node-&gt;left);return rightRotate(node);
    }
	if (balance &lt; -1 &amp;&amp; key &lt; node-&gt;right-&gt;key) {
		node-&gt;right = rightRotate(node-&gt;right);
		return leftRotate(node);
    }
	return node;
}
Node* minValueNode(Node* node) {
	Node* current = node;
	while (current-&gt;left)
		current = current-&gt;left;
	return current;
}

Node* deleteNode(Node* root, int key, int* found) {
	if (!root) return root;
	if (key &lt; root-&gt;key)
		root-&gt;left = deleteNode(root-&gt;left, key, found);
	else if (key &gt; root-&gt;key)
		root-&gt;right = deleteNode(root-&gt;right, key, found);
	else {
		*found = 1;
		if (!root-&gt;left || !root-&gt;right) {
			Node* temp = root-&gt;left ? root-&gt;left : root-&gt;right;
			if (!temp) {
				temp = root;
				root = NULL;
			} else
				*root = *temp;
			free(temp);
		} else {
			Node* temp = minValueNode(root-&gt;right);
			root-&gt;key = temp-&gt;key;
			root-&gt;right = deleteNode(root-&gt;right, temp-&gt;key, found);
		}
	}
	if (!root) return root;
	root-&gt;height = 1 + max(height(root-&gt;left), height(root-&gt;right));
	int balance = getBalance(root);
	if (balance &gt; 1 &amp;&amp; getBalance(root-&gt;left) &gt;= 0) return rightRotate(root);
	if (balance &gt; 1 &amp;&amp; getBalance(root-&gt;left) &lt; 0) {
		root-&gt;left = leftRotate(root-&gt;left);
		return rightRotate(root);
	}
	if (balance &lt; -1 &amp;&amp; getBalance(root-&gt;right) &lt;= 0) return leftRotate(root);
	if (balance &lt; -1 &amp;&amp; getBalance(root-&gt;right) &gt; 0) {
		root-&gt;right = rightRotate(root-&gt;right);
		return leftRotate(root);
	}
	return root;
}

void inorder(Node* root, FILE* out) {
	if (root) {
		inorder(root-&gt;left, out);
		fprintf(out, "%d ", root-&gt;key);
		inorder(root-&gt;right, out);
	}
}
void printInorder(Node* root) {
	FILE* temp = tmpfile();
	inorder(root, temp);
	rewind(temp);
	int x;
	while (fscanf(temp, "%d", &amp;x) == 1) {
		printf("%d ", x);
	}
	printf("\n");
	fclose(temp);
}

int main() {
	Node* root = NULL;
	char inputFile[20];
	printf("Input file name: ");
	scanf("%s", inputFile);
	FILE* in = fopen(inputFile, "r");
	if (!in) {
		printf("Error opening input file\n");
		return 1;
	}
	int val;
	char line[256];
	fgets(line, sizeof(line), in);
	while (fscanf(in, "%d", &amp;val) != EOF)
		root = insert(root, val);
	fclose(in);
	printf("In-order traversal:\n");
	printInorder(root);
	int choice, key;
	while (1) {
		printf("1. Insert\n2. Delete\n3. Write to file and exit\nChoice: ");
		scanf("%d", &amp;choice);
		switch (choice) {
			case 1:printf("Element: ");
				scanf("%d", &amp;key);
				root = insert(root, key);
				printf("In-order traversal:\n");
				printInorder(root);
				break;
			case 2:
				printf("Element: ");
				scanf("%d", &amp;key);
				int found = 0;
				root = deleteNode(root, key, &amp;found);
				if (found)
					printf("Deleted %d\n", key);
				else
					printf("%d not found\n", key);
				printf("In-order traversal:\n");
				printInorder(root);
				break;
			case 3:{
				char outputFile[100];
				printf("Output file name: ");
				scanf("%s", outputFile);
				FILE* out = fopen(outputFile, "w");
				if (!out) {
					printf("Error opening output file\n");
					return 1;
				}
				inorder(root, out);
				fprintf(out, "\n");
				fclose(out);
				printf("AVL Tree written to file\n");
				return 0;}
			default:
				printf("Invalid choice\n");
		}
	}
}</pre><br data-ref="2df5169a-a0b9-4abe-84ac-6f5b6a3bb745"></div><div class="user-solution" style="page-break-inside: auto" data-ref="39d4d3d5-1974-410e-a9a8-ef6aec88548c" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="5ee71935-bb70-4ad8-b24c-93c8e1c70211" data-undisplayed="undisplayed">input1.txt</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="6da9d54a-88ba-42dd-ad87-ae31da29bc2e" data-undisplayed="undisplayed">5
