#include&lt;limits.h&gt;
int n;
int cost[20][20];
int visited[20];
int minCost=INT_MAX;
void tsp(int city,int count,int currentCost,int start){
	if(count==n){
		if(cost[city][start]!=-1 &amp;&amp; currentCost+cost[city][start]&lt;minCost){
			minCost=currentCost+cost[city][start];
		}
		return ;
	}
	for(int i=0;i&lt;n;i++){
		if(!visited[i] &amp;&amp; cost[city][i]!=-1){
			visited[i]=1;
			tsp(i,count+1,currentCost+cost[city][i],start);
			visited[i]=0;
		}
	}
}

int main(){
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++){
		for(int j=0;j&lt;n;j++){
			scanf("%d",&amp;cost[i][j]);
		}
	}
	for(int i=0;i&lt;n;i++) visited[i]=0;
	visited[0]=1;
	tsp(0,1,0,0);
	printf("%d\n",minCost);
	return 0;
}</pre><br data-ref="268bf27b-4c68-46ef-8066-282c0e6d9f24"></div></div><div class="row" data-ref="5e098f7c-e523-430b-8d4f-666bdf70cac2"><div class="col-12" data-ref="75697449-46b4-4b0c-a5b2-e3f2c22831d5"><h5 class="execResultsHeading text-center" data-ref="d674158d-12dc-42f5-84e6-1eade3c88c4f">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="bdd51084-9bdb-4d8f-b434-5e7babe97630" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="ce2be280-b7c9-44c1-9337-62a7c66bc65e" data-split-to="ce2be280-b7c9-44c1-9337-62a7c66bc65e" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto"><div class="row execution-results-border" data-ref="4042bba7-380d-47da-8e33-ba9febf719ba"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c7cbb15e-e49e-44f0-804c-df403205cf97">Test Case - 1</div></div></div></div></div></div></div></div></div>
