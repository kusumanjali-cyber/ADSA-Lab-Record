4bde-9870-2224193ed0a3"><div class="ml-1 mb-3" data-ref="751b8b1a-5d01-4e4b-bbfa-cf6adef32b79"><b style="border-bottom:1px solid black;" data-ref="6bfed8af-d93a-4cd1-be71-82d6e504fe38" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="07763518-a0f9-4fc7-81e1-1cf7e4309cc4" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="5613c5bd-6a63-44f1-825b-b2b567ae9bce" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="5c7bcb08-feea-445f-ab4e-c2540a0b375d" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
int n,w,maxProfit=0;
int values[100],weights[100];
void knapsack(int i,int currentWeight,int currentValue){
	if(i==n){
		if(currentValue&gt;maxProfit)
			maxProfit=currentValue;
		return;
	}
	if(currentWeight+weights[i]&lt;=w){
		knapsack(i+1,currentWeight+weights[i],currentValue+values[i]);
	}
	knapsack(i+1,currentWeight,currentValue);
}
int main(){
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++){
		scanf("%d %d",&amp;values[i],&amp;weights[i]);
	}
	scanf("%d",&amp;w);
	knapsack(0,0,0);
	printf("%d\n",maxProfit);
	return 0;
}
