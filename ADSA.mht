void tsp(int city,int count,int currentCost,int start){
	if(count==n){
		if(cost[city][start]!=-1 &amp;&amp; currentCost+cost[city][start]&lt;minCost){
			minCost=currentCost+cost[city][start];
		}
		return ;
	}
	for(int i=0;i&lt;n;i++){
		if(!visited[i] &amp;&amp; cost[city][i]!=-1){
			visited[i]=1;
			tsp(i,count+1,currentCost+cost[city][i],start);
			visited[i]=0;
		}
	}
}

