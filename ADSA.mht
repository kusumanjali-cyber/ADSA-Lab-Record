int knapsack(int weights[],int profits[],int n,int m){
	int M[n+1][m+1];
	for(int i=0;i&lt;=n;i++){
		for(int j=0;j&lt;=m;j++){
			if(i==0 || j==0)
				M[i][j]=0;
			else if(weights[i-1]&lt;=j)
				M[i][j]=(profits[i-1]+M[i-1][j-weights[i-1]]&gt;M[i-1][j]) ? (profits[i-1]+M[i-1][j-weights[i-1]]) : M[i-1][j];
			else
				M[i][j]=M[i-1][j];
		}
	}
	return M[n][m];
}

int main(){
	int n;
	scanf("%d",&amp;n);
	int weights[n],profits[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;weights[i]);
	}
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;profits[i]);
	}
	int capacity;
	scanf("%d",&amp;capacity);
	int maxProfit=knapsack(weights,profits,n,capacity);
	printf("%d\n",maxProfit);
	return 0;
}</pre><br data-ref="0c62e28c-a98c-4921-93ba-e6018f84dee7"></div></div><div class="row" data-ref="38c5d4a7-0119-441b-a473-aa29fa0b7f44"><div class="col-12" data-ref="7c689800-5689-4f7a-92ae-6237257bffb8"><h5 class="execResultsHeading text-center" data-ref="8849da2c-b7fd-4458-b3c5-b628f8c0d019">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="3c7ce812-32fa-466b-8ff0-304993839dea" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="eb31578f-e36f-48a6-906b-c54b80f3a67a" data-split-to="eb31578f-e36f-48a6-906b-c54b80f3a67a" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto"><div class="row execution-results-border" data-ref="196aed08-0e13-4303-b89b-ca4a8d5febe5"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c7046ecc-1d55-488a-8c04-40f17644df75">Test Case - 1</div></div><div class="row execution-results-border" data-ref="d35258c9-10b5-4735-b554-b7990aad64ba"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="ae43e33b-1f8d-4f58-a8c9-7ef4416251b5">User Output</div></div><div class="row execution-results-border" data-ref="d5d92259-4821-4f69-a127-b052d9a4f0b8"><div class="col-6" data-ref="48d6b2ed-0759-4435-a762-7c34dd189562"><span class="cmd" title="User Input" data-ref="b28449a4-ed62-417d-9905-03960b46becc">5</span></div></div></div></div></div></div></div></div></div>
