data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="1f52fbd4-a97c-4c4b-9319-c4dfc04d22db">If a solution exists, print an <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="ba74ae75-fc8c-4321-a2b9-a7d6e52edbb6" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="006d3980-db3d-4a54-861b-17093b74ff91"><mjx-mi class="mjx-i" data-ref="7d16c32a-670c-4461-a4b2-e6ba319982d3"><mjx-c class="mjx-c1D441 TEX-I" data-ref="0b4e2b4d-3f9c-4e56-9379-5fa8cfe84bb5"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="d1d7d2d5-c733-4dfd-a935-382b65085a10"><mjx-c class="mjx-cD7" data-ref="f1848f45-6f6f-4c64-830c-74e48d8ad298"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="5c152eb9-3510-4213-a7c9-0d3a6c966e11"><mjx-c class="mjx-c1D441 TEX-I" data-ref="959679a6-2804-4d5e-b3e0-55c95f31a211"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="aeb28d25-16a0-4560-84c7-60e26a44bd6c"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="6bc7b17d-f30b-4fad-9393-53678db9835a"><mi data-ref="e5f92bd7-4c25-4f84-9c71-709b5a9f97d9">N</mi><mi data-ref="88ef104b-51be-4fcd-ac2c-9da14d378e7d">Ã—</mi><mi data-ref="1687ee06-734a-409a-ba3f-ba514e383b25">N</mi></math></mjx-assistive-mml></mjx-container> matrix consisting of 0s and 1s, where 1 represents a queen.</li><li data-ref="dff4b123-ef74-43d3-82b1-917b35abf038">If no solution exists, print: "No solution exists for N = &lt;value&gt;".</li><li data-ref="ba14f582-b86f-4039-898e-c1087aaf8399">Each row of the matrix should be printed on a new line, with space-separated values.</li></ul><p data-ref="623d7ca6-240f-40a5-bd1f-179dc9816a9c" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="b3f3b411-0a5b-491e-8161-3c2cb77caa21"></p><p data-ref="aecf8f77-cf1c-4cc7-8516-1f6b02c7b5dc" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="d210bab6-01e2-40da-9e4a-2ef3cdb25058">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="bd6b1123-144d-42e8-8980-65ff844053f8"><div class="ml-1 mb-3" data-ref="83529795-416d-45f7-a956-f2b435ec04af"><b style="border-bottom:1px solid black;" data-ref="3a30196f-ff2d-4e9b-add0-f3dea8129a4a" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="9fa5e15d-ad8d-4e67-b6b2-6c7c13cbb927" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="f11f633c-541a-41f5-973a-0dd3789657a4" data-undisplayed="undisplayed">nqueens.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="d04cdae0-f1e0-4889-86ff-1f5bca95c369" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdbool.h&gt;
#define MAX 20
int board[MAX][MAX];
void printSolution(int n){
	for(int i=0;i&lt;n;i++){
		for(int j=0;j&lt;n;j++){
			printf("%d ",board[i][j]);
		}
		printf("\n");
	}
}

bool isSafe(int row,int col,int n){
	int i,j;
	for(i=0;i&lt;row;i++){
		if(board[i][col]==1) return false;
	}
	for(i=row,j=col;i&gt;=0 &amp;&amp; j&gt;=0;i--,j--){
		if(board[i][j]==1) return false;
	}
	for(i=row,j=col;i&gt;=0 &amp;&amp; j&lt;n;i--,j++){
		if(board[i][j]==1) return false;
	}
	return true;
}

bool solveNQueens(int row,int n){
	if(row==n){
		return true;
	}
	for(int col=0;col&lt;n;col++){
		if(isSafe(row,col,n)){
			board[row][col]=1;
			if(solveNQueens(row+1,n)){
				return true;
			}
			board[row][col]=0;
		}
	}
	return false;
}

int main(){
	int n;
	scanf("%d",&amp;n);
	if(n&lt;=0 || n&gt;MAX){
		printf("Invalid board size. Please use N between 1 and %d.\n",MAX);
		return 0;
	}
	for(int i=0;i&lt;n;i++)
		for(int j=0;j&lt;n;j++)
			board[i][j]=0;
			if(solveNQueens(0,n)){
				printSolution(n);
			}
			else{
				printf("No solution exists for N = %d\n",n);
