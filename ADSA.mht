athJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="95e27f81-5e73-4604-8b1b-1a0c9f9d152e" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="62061377-61b9-4e90-948f-fb96f99ef54b"><mjx-mi class="mjx-i" data-ref="d8b904a5-3a9a-41e6-b034-edd2c579c9fd"><mjx-c class="mjx-c1D458 TEX-I" data-ref="d09fe25a-4812-4eca-9140-7d764d45529b"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="7f101a05-1016-4d8c-a3b4-9de5857af1d3"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="d1a3d36f-6a4f-47a7-bd69-05d0e12f7627"><mi data-ref="29ffadb4-fb3b-4d53-aa43-8ed9b912b317">k</mi></math></mjx-assistive-mml></mjx-container> deletions of the root element.</li></ul><p data-ref="75b23759-3ec7-4fb0-885c-48a7f6c11abe" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="08a6d84b-5365-4fd1-839c-4181a427f776"></p><p data-ref="2f6f3fb2-479b-459c-ad38-cffa6dff44fa" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="c35df0a6-5aed-4b51-9c64-012d97be81b4">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="1cc9811a-c19e-420f-beee-5c676fa77198"><div class="ml-1 mb-3" data-ref="18b5b78a-d358-43a1-afc2-0668b1ac75f1"><b style="border-bottom:1px solid black;" data-ref="10b017cd-23ad-40d7-a7d2-bac7c3dab5bd" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="ac2f941b-2050-4c1a-b9ee-2442a07c2e08" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="42ba4b22-b31a-4f72-b0d5-c377f213aa33" data-undisplayed="undisplayed">maxheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="e3ac563a-74a9-418b-84f0-60670e65c177" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#define MAX 20
int heap[MAX];
int size=0;
void swap(int *a,int *b){
	int temp=*a;
	*a=*b;
	*b=temp;
}
void heapifyUp(int index){
	while(index&gt;0){
		int p=(index-1)/2;
		if(heap[index]&gt;heap[p]){
			swap(&amp;heap[index],&amp;heap[p]);
			index=p;
		}else{
			break;
		}
	}
}
void insert(int val){
	heap[size]=val;
	heapifyUp(size);
	size++;
}
void heapifyDown(int index){
	while(1){
		int l=2*index+1;
		int r=2*index+2;
		int big=index;
		if(l&lt;size &amp;&amp; heap[l]&gt;heap[big])
			big=l;
		if(r&lt;size &amp;&amp; heap[r]&gt;heap[big])
			big=r;
		if(big!=index){
			swap(&amp;heap[index],&amp;heap[big]);
			index=big;
		}else{
			break;
		}
	}
}
void deleteMax(){
	if(size==0)
		return;
	heap[0]=heap[size-1];
	size--;
	heapifyDown(0);
}
void printHeap(){
	for(int i=0;i&lt;size;i++){
		printf("%d ",heap[i]);
	}
}
int main(){
	int n,val,del;
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;val);
		insert(val);
	}
	printHeap();
	scanf("%d\n",&amp;del);
	for(int i=0;i&lt;del;i++){
		deleteMax();
	}
	printHeap();
	printf("\n");
	return 0;
}</pre><br data-ref="063d5d18-8027-4c5e-927f-2bd2a13a0263"></div></div><div class="row" data-ref="2f31fac3-b7fe-4065-a5c8-cda77f707260"><div class="col-12" data-ref="fdd905b5-93cc-49c7-8d0e-10f14065bb9a"><h5 class="execResultsHeading text-center" data-ref="0a051e40-e16e-453c-97c2-a361f8d71a1f">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="7076881f-251c-4550-b1ae-86575c9292a3" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="806c5938-1d55-47a1-9307-b524320a8a86"><div class="row execution-results-border" data-ref="59b9fc9e-e923-42d6-9cd5-c6904b2adf2e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="f14204bf-5f27-49e0-8493-27d61133a050">Test Case - 1</div></div><div class="row execution-results-border" data-ref="4eb05c92-f149-4688-9c94-e21c51093132"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="338471f9-1534-4f1a-99e1-fd7c09457fbf">User Output</div></div><div class="row execution-results-border" data-ref="870c2d90-e3a1-4b2a-86f4-e08db801d773"><div class="col-6" data-ref="5a6da8b4-3799-4f7e-a7b2-237f5ebf4509"><span class="cmd" title="User Input" data-ref="f140bcc9-07b5-48bf-a452-80fb90d46ea7">6</span></div></div><div class="row execution-results-border" data-ref="33d8c537-6a7d-48a5-a59c-5a615653f530"><div class="col-6" data-ref="445be738-ace2-445e-b0a4-ed3b75e6606d"><span class="cmd" title="User Input" data-ref="79b5b11a-43a3-4c84-bd76-225e629f5459">30 10 20 40 50 5</span></div></div><div class="row execution-results-border" data-ref="913304d3-3dfa-45c2-9385-56ed434a16a8"><div class="col-6" data-ref="6d17577f-fcbc-45b7-ad11-30c9ac88a88e"><span class="cmd" title="User Input" data-ref="c4611ccb-4742-47f9-a7e0-bd4190bbc96c">2</span></div></div><div class="row execution-results-border" data-ref="192c3801-065b-4145-ae6b-43f6c578fe2e"><div class="col-12" data-ref="65b2868f-c64d-471a-8435-d6737e8f2418"><pre class="outputPre" data-ref=