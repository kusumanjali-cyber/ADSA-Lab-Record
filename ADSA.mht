a-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="c135d149-bdb2-4356-ac47-479d55a23b6c">The output consists of <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="a101d753-d9a0-4568-8bc8-e1b58ef91b6e" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="2bb2999e-2fa2-40ce-b4bb-c46a617f925f"><mjx-mi class="mjx-i" data-ref="8199dbe2-9534-4698-95ec-738fead1b250"><mjx-c class="mjx-c1D449 TEX-I" data-ref="f8f224a3-bc8a-4625-a9be-d434ec4f2562"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="ce9d9f03-57fd-4d4d-b9ce-843657920c8f"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="c683d79b-05b5-491a-a970-10e225b483c3"><mi data-ref="eb92af03-a5a8-48cd-8faa-5f2c167973a4">V</mi></math></mjx-assistive-mml></mjx-container> lines.</li><li data-ref="81993d5a-6e5f-446b-b051-8ec7047a2352">Each line contains two integers:</li><li class="ql-indent-1" data-ref="2927430f-5375-4077-959f-7a9d4ec12009">The vertex number and the minimum distance from the source vertex to that vertex, space separated</li></ul><p data-ref="879ac9c7-4819-4d96-8356-3846fabbf00e" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="1b2bf514-c1e1-49e2-ba19-6f338de85a7b"></p><p data-ref="dd6a8efa-d845-49a8-a6e8-509431590318" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="746e0db7-c6ef-4196-9f38-b10c91ed9cd9">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="4d606fd5-8411-486c-a5f9-42757c105f01"><div class="ml-1 mb-3" data-ref="f8e67fda-93f6-44ca-9036-13dfd5cef0b6"><b style="border-bottom:1px solid black;" data-ref="fa2bf316-ce99-47de-8b01-5064baf75f41" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="d34a570a-4486-4194-bd1d-5a72d219a6eb" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="ee5ab5d4-3a56-4806-8f19-e4271b17c047" data-undisplayed="undisplayed">Path.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="0b735627-1083-484c-9291-2eec88dd4561" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;limits.h&gt;
#define MAX 100
#define INF INT_MAX
int n,m;
int graph[MAX][MAX];
int minDistance(int dist[],int visited[]){
	int min=INF,min_index=-1;
	for(int v=0;v&lt;n;v++){
		if(!visited[v]&amp;&amp;dist[v]&lt;=min){
			min=dist[v];
			min_index=v;
		}
	}
	return min_index;
}
void dijkstra(int src){
	int dist[MAX];
	int visited[MAX];
	for(int i=0;i&lt;n;i++){
		dist[i]=INF;
		visited[i]=0;
	}
	dist[src]=0;
	for(int count=0;count&lt;n-1;count++){
		int u=minDistance(dist,visited);
		if(u==-1)break;
		visited[u]=1;
		for(int v=0;v&lt;n;v++){
			if(!visited[v]&amp;&amp;graph[u][v]!=INF&amp;&amp;dist[u]!=INF&amp;&amp;dist[u]+graph[u][v]&lt;dist[v]){
				dist[v]=dist[u]+graph[u][v];
			}
		}
	}
	for(int i=0;i&lt;n;i++){
		if(dist[i]==INF)
			printf("%d-1\n",i);
		else
			printf("%d %d\n",i,dist[i]);
	}
}
int main(){
	scanf("%d %d",&amp;n,&amp;m);
	for(int i=0;i&lt;n;i++)
		for(int j=0;j&lt;n;j++)
			graph[i][j]=INF;
	for(int i=0;i&lt;m;i++){
		int u,v,w;
		scanf("%d %d %d",&amp;u,&amp;v,&amp;w);
		graph[u][v]=w;
	}
	int src;
	scanf("%d",&amp;src);
	dijkstra(src);
	return 0;
}</pre><br data-ref="78eeed76-303f-462d-b13a-8a2e1d0b8ee0"></div></div><div class="row" data-ref="07cc87ee-036c-42f1-bef4-4f493d00b3e9"><div class="col-12" data-ref="cb288f07-3373-472d-b626-60cc706622bb"><h5 class="execResultsHeading text-center" data-ref="1fc1b630-b350-4b01-8c17-e11195d22c75">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="7b1668ea-0191-45f5-a41c-b8b83b146c7c" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="ba3bbbff-a224-4c23-b716-f00bd529700a"><div class="row execution-results-border" data-ref="262ad33e-b5ac-4ecb-bd8f-d0f17a2e9f48"><div class="col-12 p-2 text-center font-weight-bold" data-ref="a1178eaa-bfbb-4702-9ca4-2f3c69d01ac2">Test Case - 1</div></div><div class="row execution-results-border" data-ref="01cf0089-5526-4dfc-9255-a96e724d9c98"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="ec5c0e7c-1867-485b-b68e-52780f62236b">User Output</div></div><div class="row execution-results-border" data-ref="748e9e8b-aa9a-4004-9762-c5be4265fe17"><div class="col-6" data-ref="72ab7efd-6411-4843-be63-f96bf91ca3e5"><span class="cmd" title="User Input" data-ref="530fa124-d191-4508-a6ec-54c87cd247b3">4 3</span></div></div><div class="row execution-results-border" data-ref="43fb2a44-2cb1-435e-b86c-7c2025ed5c11"><div class="col-6" data-ref="88ebfcf4-051f-439a-b915-94756f17fb3d"><span class="cmd" title="User Input" data-ref="dd13cef8-01d4-4910-8007-0271ea171047">0 1 2</span></div></div><div class="row execution-results-border" data-ref="0c86751e-43f6-4c82-bceb-c2928dad67ec"><div class="col-6" data-ref="81d6e985-fc86-41d1-896f-b9ae72a66233"><span class="cmd" title="User Input" data-ref="73bfbbd6-602a-48af-834b-de45f961e3a9">0 2 5</span></div></div><div class="row execution-results-border" data-ref="0b3b4e61-a8e6-4a0d-8086-47dc43f586fa"><div class="col-6" data-ref="9c3e8e53-03e2-4e8a-8a69-68925a55531a"><span class="cmd" title="User Input" d