ta-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="f49ef513-e70f-4a83-8531-e1010e6d7bd0"></p><p data-ref="b85d2254-225e-48df-bdb8-5a24f6aa33f9" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="33d3b279-67ad-4f5a-bed3-1eeb4964bc1f">ï»¿Note: </strong></p><ul data-ref="1301b5e2-abc6-4475-a76d-7540a4be66de" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="6473bde0-3707-418f-b0fd-c90e22a069d1">In DFS, the smaller numbered node is visited first when there are multiple adjacent nodes, ensuring a consistent traversal order</li><li data-ref="c5897e5d-cc61-42d0-9bfc-fabc1055257e">Refer to the visible test cases for a better understanding.</li></ul></span></div><div class="mb-3" data-ref="b6be057f-1e6b-4351-a18b-8affec433486"><div class="ml-1 mb-3" data-ref="7b8d5005-291c-4c71-bde2-65be56e3611a"><b style="border-bottom:1px solid black;" data-ref="71de82fd-e0d8-419a-ad07-915a221251ef" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="67733cfe-c74d-4200-9fef-25de08fc6207" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="9692e809-44d6-48ce-bd04-5edb11d1d1b8" data-undisplayed="undisplayed">dfs_directed_graph.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="e38d6b9f-a283-4edd-aaf3-e28ed9b85ade" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX];
int visited[MAX];
int adjCount[MAX];
int compare(const void *a,const void *b){
	return (*(int *)a-*(int *)b);
}
void dfs(int vertex){
	visited[vertex]=1;
	printf("%d ",vertex);
	for(int i=0;i&lt;adjCount[vertex];i++){
		int neighbor=adj[vertex][i];
		if(!visited[neighbor]){
			dfs(neighbor);
		}
	}
}
int main(){
	int vertices,edges;
	scanf("%d %d",&amp;vertices,&amp;edges);
	for(int i=0;i&lt;vertices;i++){
		adjCount[i]=0;
		visited[i]=0;
	}
	for(int i=0;i&lt;edges;i++){
		int u,v;
		scanf("%d %d",&amp;u,&amp;v);
		adj[u][adjCount[u]++]=v;
	}
	for(int i=0;i&lt;vertices;i++){
		qsort(adj[i],adjCount[i],sizeof(int),compare);
	}
	int start;
	scanf("%d",&amp;start);
	dfs(start);
	return 0;
}</pre><br data-ref="f5f4b2d8-9406-418d-9d4d-9c3cde4c1b49"></div></div><div class="row" data-ref="5c5ad32f-2759-4656-a31e-ffefe9184200"><div class="col-12" data-ref="2f66a0e8-90b7-4533-bbdf-564ebdba30e1"><h5 class="execResultsHeading text-center" data-ref="84464879-2131-4e9c-92dc-3ec7dfec521d">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="99d90fa8-3e1e-49df-94d2-fa9a7f078cb4" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="1e489cbd-db3f-422b-9e42-53d9c9153f8f"><div class="row execution-results-border" data-ref="d9bba2b8-73df-44c9-8419-17b8685a8ab4"><div class="col-12 p-2 text-center font-weight-bold" data-ref="2b32e283-3ba3-4a9b-a808-d4b3b0f3c7ef">Test Case - 1</div></div><div class="row execution-results-border" data-ref="311e6ebe-c5f3-479c-a94f-3f462e036906"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="0c8524a9-369f-424e-bd7f-1fea7d5a829a">User Output</div></div><div class="row execution-results-border" data-ref="2d95dfe3-f2db-4fdf-bad9-af7f456a12bc"><div class="col-6" data-ref="7994adf9-e7d1-49fc-9c2c-e01e17a6bbab"><span class="cmd" title="User Input" data-ref="3e283202-94a8-41c3-88e5-92cc75c3d97f">5 6</span></div></div><div class="row execution-results-border" data-ref="29945224-1309-48d7-a613-271b1451d744"><div class="col-6" data-ref="b61e5928-a718-4113-96c7-da59f849018f"><span class="cmd" title="User Input" data-ref="179bcf23-6bfa-4518-8f14-6255c7f5b68e">0 1</span></div></div><div class="row execution-results-border" data-ref="7d6738cc-8082-444d-a15a-2d0646181bf8"><div class="col-6" data-ref="bb0d76ee-a2c4-451f-8815-5c2e732dd085"><span class="cmd" title="User Input" data-ref="898f9506-0a7f-4012-a98e-3fc638d9f4fa">0 2</span></div></div><div class="row execution-results-border" data-ref="ee965774-9c76-4cff-9330-91335afe9115"><div class="col-6" data-ref="f4c867af-633d-46d3-a458-37a8f874f3a4"><span class="cmd" title="User Input" data-